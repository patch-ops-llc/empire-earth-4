<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Every console tool of the project in one program. Each tool is a class implementing ITool in its
    own folder. The program finds them by reflection, so adding a tool adds a folder and edits no
    shared file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
  </ItemGroup>

</Project>
