<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The real network under the session: IConnection over LiteNetLib's reliable UDP, with a
    listener for the host and a connector for a client. Sockets, the package and its threads live
    here, so that Net itself stays free of all three. It must never reference Godot.
  -->

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="2.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Net/Net.csproj" />
  </ItemGroup>

</Project>
