// Ridge: the sample one-versus-one map (game design 5.3). A cliff ridge runs down the middle between
// the two bases. It is crossed by a pass 6 tiles wide in the north and a gap 28 tiles wide in the south.
//
// Tiles are (x, y) with (0, 0) at the first character of the first row of "terrain"; x grows to the
// right and y grows downward. A position names the lowest tile of a footprint.
{
  "$schema": "../../../schemas/map.schema.json",
  "id": "ridge",
  "width": 96,
  "height": 96,

  // mirror_x: the right half is the left half reflected, so tile (x, y) matches tile (95 - x, y).
  "symmetry": "mirror_x",

  // The starting Capitols, 4 by 4 tiles each.
  "starts": [
    { "x": 10, "y": 46 },
    { "x": 82, "y": 46 }
  ],

  // Ten deposits of 2 by 2 tiles: two in each main base, inside the starting territory; one natural
  // expansion each; four contested.
  "deposits": [
    { "kind": "main", "x": 6, "y": 38 },
    { "kind": "main", "x": 6, "y": 56 },
    { "kind": "main", "x": 88, "y": 38 },
    { "kind": "main", "x": 88, "y": 56 },
    { "kind": "natural", "x": 24, "y": 70 },
    { "kind": "natural", "x": 70, "y": 70 },
    { "kind": "contested", "x": 38, "y": 22 },
    { "kind": "contested", "x": 56, "y": 22 },
    { "kind": "contested", "x": 38, "y": 62 },
    { "kind": "contested", "x": 56, "y": 62 }
  ],

  // Each marker covers the passage through the ridge; "across" is the axis its width runs along.
  "markers": [
    { "kind": "chokepoint", "x": 46, "y": 20, "size_x": 4, "size_y": 6, "across": "y" },
    { "kind": "open_field", "x": 46, "y": 50, "size_x": 4, "size_y": 28, "across": "y" }
  ],

  // One row per y, one character per x: "." open ground, "F" forest, "#" cliff.
  "terrain": [
    "..............................................####..............................................",
    "..............................................####..............................................",
    "..............................................####..............................................",
    "..............................................####..............................................",
