// Elite: fewer, better units (game design 5.5).
{
  "$schema": "../../../schemas/ai.schema.json",
  "id": "elite",
  "name": "Elite",

  // Item 1: the workers it keeps in each epoch, and the stockpile at which it expands.
  "economy": {
    "workers": [
      { "epoch": 1, "workers": 16 },
      { "epoch": 2, "workers": 22 },
      { "epoch": 3, "workers": 28 }
    ],
    "expand_at_materials": 600
  },

  // Item 2: it leads with Firepower, Protection and Extraction.
  "research": {
    "weights": {
      "firepower": 6,
      "protection": 5,
      "mobility": 2,
      "manufacturing": 1,
      "logistics": 3,
      "extraction": 4
    }
  },

  // Item 3: Guard and Artillery.
  "army": {
    "lines": [
      { "line": "guard", "share": 2 },
      { "line": "artillery", "share": 1 }
    ]
  },

  // Item 5: it attacks when its army is worth 1.3 times what it takes the enemy's to be worth, or
  // when it is at its supply cap, and retreats when it has lost 40% of the force it attacked with.
  // The worth of an army is the price of its units. Until it has seen more, it takes the enemy's
  // army to be worth "assumed_enemy_value". While a force is attacking, new units follow it
  // "reinforce_units" at a time. Its few units go through the chokepoint, where few can reach them at once.
  // "reaction_seconds" is the reaction delay of Normal difficulty.
  "fight": {
    "attack_ratio": "1.3",
    "assumed_enemy_value": 400,
    "retreat_losses": "0.4",
    "reinforce_units": 6,
    "passage": "chokepoint",
    "raid": { "line": "cavalry_armor", "party": 4 },
    "reaction_seconds": 1
  }
}
