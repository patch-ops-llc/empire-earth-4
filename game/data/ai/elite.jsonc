// Elite: fewer, better units (game design 5.5).
{
  "$schema": "../../../schemas/ai.schema.json",
  "id": "elite",
  "name": "Elite",

  // Item 1: the workers it keeps in each epoch, and the stockpile at which it expands.
  "economy": {
    "workers": [
      { "epoch": 1, "workers": 16 },
      { "epoch": 2, "workers": 22 },
      { "epoch": 3, "workers": 28 }
    ],
    "expand_at_materials": 600
  },

  // Item 2: it leads with Firepower, Protection and Extraction.
  "research": {
    "weights": {
      "firepower": 6,
      "protection": 5,
      "mobility": 2,
      "manufacturing": 1,
      "logistics": 3,
      "extraction": 4
    }
  },

  // Item 3: Guard and Artillery.
  "army": {
    "lines": [
      { "line": "guard", "share": 2 },
      { "line": "artillery", "share": 1 }
    ]
  }
}
