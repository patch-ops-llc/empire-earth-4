; A view piece adds its actions directly under the line that names it, so that two pieces never
; add at the same place and their pull requests merge in either order. This file is edited by
; hand: saving the project settings from the editor drops these lines.

; 11v. Combat.

; 13v. Economy.

; 14v. Research.

; 15v. Construction and production.

; 17v. Fog of war.

; Later pieces.

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
