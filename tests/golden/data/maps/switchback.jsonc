// Switchback: a map made for the golden replays, and not one the game ships. It is the sample map's
// layout (two bases, a ridge down the middle with a pass in the north and a gap in the south) with
// three cliff walls in each half. The way past the walls alternates between the bottom and the top
// of the map, so a unit that crosses its half walks a long route and finding that route costs a
// large part of one tick's search budget. Orders that need several such routes in one tick make
// units wait for theirs, which the sample map never does.
//
// Tiles are (x, y) with (0, 0) at the first character of the first row of "terrain"; x grows to the
// right and y grows downward. A position names the lowest tile of a footprint.
{
  "$schema": "../../../../schemas/map.schema.json",
  "id": "switchback",
  "width": 96,
  "height": 96,
  "symmetry": "mirror_x",

  "starts": [
    { "x": 10, "y": 46 },
    { "x": 82, "y": 46 }
  ],

  "deposits": [
    { "kind": "main", "x": 6, "y": 38 },
    { "kind": "main", "x": 6, "y": 56 },
    { "kind": "main", "x": 88, "y": 38 },
    { "kind": "main", "x": 88, "y": 56 },
    { "kind": "natural", "x": 24, "y": 70 },
    { "kind": "natural", "x": 70, "y": 70 },
    { "kind": "contested", "x": 38, "y": 22 },
    { "kind": "contested", "x": 56, "y": 22 },
    { "kind": "contested", "x": 38, "y": 62 },
    { "kind": "contested", "x": 56, "y": 62 }
  ],

  "markers": [
    { "kind": "chokepoint", "x": 46, "y": 20, "size_x": 4, "size_y": 6, "across": "y" },
    { "kind": "open_field", "x": 46, "y": 50, "size_x": 4, "size_y": 28, "across": "y" }
  ],

  // One row per y, one character per x: "." open ground, "F" forest, "#" cliff.
