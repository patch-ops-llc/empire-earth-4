<Project>

  <!-- Whole-number overflow throws instead of wrapping (docs/determinism.md, rule 7) in every
       build that is not optimized for speed: Debug, which the tests and the Godot editor use, and
       ExportDebug. Code that wraps on purpose says unchecked. -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release' and '$(Configuration)' != 'ExportRelease'">
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
  </PropertyGroup>

  <PropertyGroup>
    <!-- game/Game.csproj repeats TargetFramework because the Godot editor requires it there. Change both. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- The text that names a build of the game, which two players must share to play one match
       (game/scripts/GameInfo.cs reads it back). The export workflow sets the GAME_VERSION
       environment variable, to the tag or to "dev-" and the commit. A build made any other way
       is "dev". The commit is not appended, so that the text is exactly what was set. -->
  <PropertyGroup>
    <GameVersion Condition="'$(GAME_VERSION)' != ''">$(GAME_VERSION)</GameVersion>
    <GameVersion Condition="'$(GameVersion)' == ''">dev</GameVersion>
    <InformationalVersion>$(GameVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Godot exports build the solution as ExportRelease, a name the plain .NET projects do not
       know, so without this they would ship unoptimized. -->
  <PropertyGroup Condition="'$(Configuration)' == 'ExportRelease'">
    <Optimize>true</Optimize>
  </PropertyGroup>

</Project>
